---
import '../styles/globals.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Micelio ArteWeb — Diseño con forma, ideas con raíz',
	description = 'Micelio ArteWeb: diseño de identidad visual, desarrollo web y marketing digital para marcas con una visión propia.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#efede7" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
		<script>
			import '../scripts/gsap-animations.js';
		</script>
	</body>
</html>
