---
import { ArrowUpRight } from "lucide-astro";
---

<section class="contact section-pad" id="contacto">
  <div class="contact-topline">
    <span>04 / CONTACTO</span><span>ESTAMOS PARA ESCUCHARTE</span>
  </div>
  <div class="contact-main">
    <div class="contact-content">
      <p class="contact-kicker">
        <span class="eyebrow-dot"></span> ¿Tienes algo en mente?
      </p>
      <h2>Hagamos realidad<br /><em>tu idea.</em></h2>
      <p class="contact-copy">
        Cuéntanos tu idea, tu reto o eso que llevas tiempo imaginando. Nos
        encantará escucharte.
      </p>
      <a
        class="contact-button"
        href="mailto:hola@micelioarteweb.com?subject=Quiero%20iniciar%20un%20proyecto"
      >
        Contáctanos <ArrowUpRight size={17} strokeWidth={1.5} />
      </a>
    </div>
    <figure class="contact-aside">
      <img
        class="contact-image"
        src="/section-images/contact-images/micelio-micelio.png"
        alt="Escultura blanca ramificada sobre un fondo oscuro"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
  <div class="contact-bottom">
    <span>BUENAS IDEAS, BUENAS CONVERSACIONES.</span>
    <a href="mailto:hola@micelioarteweb.com"
      >HOLA@MICELIOARTEWEB.COM <ArrowUpRight size={13} /></a
    >
  </div>
</section>
