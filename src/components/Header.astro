---
import { ArrowUpRight, Menu, X } from "lucide-astro";

const links = [
  ["#manifiesto", "Nosotros"],
  ["#exposicion", "Proyectos"],
  ["#servicios", "Servicios"],
];
---

<header class="site-header">
  <a class="brand" href="#inicio" aria-label="Micelio ArteWeb, inicio">
    <img src="/brand/logo-micelio.svg" alt="micelio" class="brand-mark" />
    <span class="brand-divider" aria-hidden="true"></span>
    <img src="/brand/arteweb.svg" alt="ArteWeb" class="brand-word" />
  </a>
  <nav class="desktop-nav" aria-label="Navegación principal">
    {links.map(([href, label]) => <a href={href}>{label}</a>)}
  </nav>
  <a class="header-cta" href="#contacto"
    >Contáctanos <ArrowUpRight size={15} strokeWidth={1.6} /></a
  >
  <button
    class="menu-toggle"
    type="button"
    aria-label="Abrir menú"
    aria-expanded="false"
  >
    <Menu class="menu-open-icon" size={23} strokeWidth={1.5} />
    <X class="menu-close-icon" size={23} strokeWidth={1.5} />
  </button>
</header>
<nav class="mobile-nav" aria-label="Navegación móvil" aria-hidden="true">
  {
    links.map(([href, label]) => (
      <a href={href}>
        {label} <ArrowUpRight size={17} />
      </a>
    ))
  }
  <a href="#contacto">Contáctanos <ArrowUpRight size={17} /></a>
</nav>
